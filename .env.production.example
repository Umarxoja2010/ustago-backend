# ==============================================================================
# UstaGo Avto — Production Environment Configuration (.env)
# Render.com Deployment Template
# ==============================================================================

APP_NAME="UstaGo Avto"
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://your-backend-app.onrender.com

APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Database — SQLite for Render.com (No external MySQL server needed)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# File storage (Public uploads)
FILESYSTEM_DISK=public

BROADCAST_CONNECTION=log

# CORS & Sanctum configuration:
# Frontend URL deployed on Render.com (e.g. https://ustago-avto.onrender.com)
FRONTEND_URL=https://your-frontend-app.onrender.com
SANCTUM_STATEFUL_DOMAINS=your-frontend-app.onrender.com

# Initial Administrator Credentials (defaults to admin@ustago.uz / Admin12345!)
ADMIN_EMAIL=admin@ustago.uz
ADMIN_PASSWORD=Admin12345!
ADMIN_PHONE=+998900000001

